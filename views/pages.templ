package views

import (
	"fmt"
	"strconv"
	"strings"
	"yasssm/components/button"
	"yasssm/components/card"
	"yasssm/components/icon"
	"yasssm/components/input"
	"yasssm/components/label"
	"yasssm/components/nativeselect"
	"yasssm/components/progress"
	"yasssm/internal/host"
)

templ LoginPage(p Page, errMsg string) {
	@Layout(p) {
		<div class="flex min-h-[70svh] items-center justify-center">
			@card.Card(card.Props{Class: "w-full max-w-sm"}) {
				@card.Header() {
					<div class="mb-2 text-4xl leading-none" aria-hidden="true">🐍</div>
					@card.Title() {
						yasssm · { p.Host }
					}
					@card.Description() {
						Enter the 6-digit code from your authenticator app.
					}
				}
				@card.Content() {
					<form method="post" action="/login" class="space-y-4">
						<div class="space-y-2">
							@label.Label(label.Props{For: "code"}) {
								Authenticator code
							}
							@input.Input(input.Props{
								ID:       "code",
								Name:     "code",
								Required: true,
								Class:    "h-12 text-center text-xl tabular-nums tracking-[0.4em]",
								Attributes: templ.Attributes{
									"inputmode":    "numeric",
									"autocomplete": "one-time-code",
									"pattern":      "[0-9]{6}",
									"maxlength":    "6",
									"autofocus":    true,
									"aria-invalid": errMsg != "",
								},
							})
							if errMsg != "" {
								<p class="text-sm text-destructive">{ errMsg }</p>
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
							@icon.Key(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
							Log in
						}
					</form>
				}
			}
		</div>
	}
}

templ DashboardPage(p Page, d Dashboard) {
	@Layout(p) {
		<div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
			@stat(icon.Clock, "Uptime", d.System.Uptime, -1)
			@stat(icon.Cpu, fmt.Sprintf("Load · %d CPUs", d.System.CPUs), d.System.Load, -1)
			@stat(icon.Memory, "Memory", d.System.MemUsed+" / "+d.System.MemTotal, d.System.MemPct)
			@stat(icon.HardDrive, "Disk /", d.System.DiskUsed+" / "+d.System.DiskSize, d.System.DiskPct)
		</div>
		<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
			@pageTitle(icon.Stack, "Stacks")
			<p class="text-sm text-muted-foreground">
				{ strconv.Itoa(d.Stacks) } stacks · { strconv.Itoa(d.Running) }/{ strconv.Itoa(d.Total) } containers running
			</p>
		</div>
		if d.Err != "" {
			@errorAlert(d.Err)
		}
		for _, g := range d.Groups {
			@groupCard(g)
		}
	}
}

// stat renders one system number; pct < 0 hides the progress bar.
templ stat(ic func(...icon.Props) templ.Component, name, value string, pct int) {
	@card.Card(card.Props{Size: card.SizeSm}) {
		@card.Header() {
			@card.Description(card.DescriptionProps{Class: "flex items-center gap-1.5 text-xs sm:text-sm"}) {
				@ic(icon.Props{Class: "size-3.5 shrink-0"})
				<span class="truncate">{ name }</span>
			}
			@card.Title(card.TitleProps{Class: "text-sm tabular-nums sm:text-base"}) {
				{ value }
			}
		}
		if pct >= 0 {
			@card.Content() {
				@progress.Progress(progress.Props{Value: pct, Attributes: templ.Attributes{"title": strconv.Itoa(pct) + "%"}})
			}
		}
	}
}

templ groupCard(g Group) {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "flex flex-wrap items-center gap-x-3 gap-y-1"}) {
				<span class="flex items-center gap-2">
					@icon.Stack(icon.Props{Class: "size-4 text-muted-foreground"})
					{ g.Title }
				</span>
				for _, c := range g.Counts {
					<span class="inline-flex items-center gap-1.5 text-xs font-normal text-muted-foreground" title={ countLabel(c) }>
						@statusDot(c.State)
						if c.N > 0 {
							{ strconv.Itoa(c.N) }
						} else {
							{ c.State }
						}
					</span>
				}
			}
			<div data-slot="card-description" class="text-sm text-muted-foreground">
				if g.Dir != "" {
					<span class="font-mono text-xs break-all">{ g.Dir }/<span class="text-foreground/80">{ strings.Join(g.Files, " + ") }</span></span>
				} else {
					{ g.Note }
				}
			</div>
			if len(g.Actions) > 0 {
				@card.Action(card.ActionProps{Class: "grid grid-cols-2 gap-1.5 @md/card-header:flex @md/card-header:flex-wrap @md/card-header:justify-end @md/card-header:gap-1"}) {
					for _, a := range g.Actions {
						@actionButton(a)
					}
				}
			}
		}
		@card.Content() {
			if len(g.Rows) == 0 {
				@muted("No containers yet. Up creates them.")
			} else {
				<ul class="divide-y border-t">
					for _, r := range g.Rows {
						@containerRow(r)
					}
				</ul>
			}
		}
	}
}

// containerRow is one list item: the name (a link to the logs) over a line
// of status, image and ports, with the actions on the right. Phones drop
// the compose service name and the logs button (the name is the link) so
// long names keep their room next to the 44px action buttons.
templ containerRow(r ContainerRow) {
	<li class="flex items-center gap-2 py-2">
		<div class="min-w-0 flex-1 space-y-1">
			<div class="flex min-w-0 items-center gap-2">
				@statusDot(r.State)
				<a href={ templ.SafeURL(r.LogsURL) } class="truncate font-medium text-primary underline-offset-4 hover:underline">{ r.Name }</a>
				if r.Service != "" && r.Service != r.Name {
					<span class="hidden truncate text-xs text-muted-foreground sm:inline">{ r.Service }</span>
				}
			</div>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 pl-4.5 text-xs text-muted-foreground">
				<span>{ r.Status }</span>
				<span class="max-w-full truncate font-mono sm:max-w-64" title={ r.Image }>{ r.Image }</span>
				@portChips(r.Ports)
			</div>
		</div>
		<div class="flex shrink-0 gap-0.5">
			<span class="hidden sm:contents">
				@iconAction(Link{Action: "logs", Label: "Logs", URL: r.LogsURL})
			</span>
			for _, a := range r.Actions {
				@iconAction(a)
			}
		</div>
	</li>
}

templ portChips(ports []string) {
	for _, pt := range ports {
		<span class="rounded-sm border px-1 font-mono whitespace-nowrap">{ pt }</span>
	}
}

templ LogsPage(p Page, d Logs) {
	@Layout(p) {
		<div class="space-y-3">
			@backLink("/", "Stacks")
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
					@pageTitle(icon.Scroll, d.Container.Name)
					<span class="text-sm text-muted-foreground">
						@statusLine(d.Container.State, d.Container.Status)
					</span>
					<div class="flex gap-0.5">
						for _, a := range d.Container.Actions {
							@iconAction(a)
						}
					</div>
				</div>
				<form method="get" class="flex items-center gap-2">
					@nativeselect.NativeSelect(nativeselect.Props{Name: "n", Size: nativeselect.SizeSm, Attributes: templ.Attributes{"aria-label": "Lines"}}) {
						for _, n := range d.Sizes {
							@nativeselect.Option(nativeselect.OptionProps{Value: strconv.Itoa(n), Selected: n == d.N}) {
								{ strconv.Itoa(n) } lines
							}
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
						@icon.ArrowsClockwise(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
						Reload
					}
				</form>
			</div>
		</div>
		@output(d.Output)
	}
}

templ ConfirmPage(p Page, d Confirm) {
	@Layout(p) {
		@card.Card(card.Props{Class: "mx-auto max-w-2xl"}) {
			<form method="post" action="/action" class="contents">
				@card.Header() {
					<div class={ "mb-2 flex size-10 items-center justify-center rounded-lg", templ.KV("bg-destructive/10 text-destructive", d.Danger), templ.KV("bg-muted", !d.Danger) }>
						if d.Danger {
							@icon.Warning(icon.Props{Class: "size-5"})
						} else {
							@actionIcon(d.Action)(icon.Props{Class: "size-5"})
						}
					</div>
					@card.Title(card.TitleProps{Class: "break-all"}) {
						{ d.Label } { d.Kind } <span class="bg-accent px-1 font-semibold text-accent-foreground">{ d.Name }</span>?
					}
					@card.Description(card.DescriptionProps{Class: "flex items-center gap-1.5"}) {
						@icon.Terminal(icon.Props{Class: "size-3.5"})
						This runs:
					}
				}
				@card.Content() {
					@output(commandLines(d.Commands))
					<input type="hidden" name="kind" value={ d.Kind }/>
					<input type="hidden" name="name" value={ d.Name }/>
					<input type="hidden" name="action" value={ d.Action }/>
				}
				@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
					@button.Button(button.Props{Href: "/", Variant: button.VariantOutline, Class: "flex-1 sm:flex-none"}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: confirmVariant(d.Danger), Class: "flex-1 sm:flex-none"}) {
						@actionIcon(d.Action)(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
						{ d.Label }
					}
				}
			</form>
		}
	}
}

// countLabel is "3 running", or just the state for a count-less one ("not created").
func countLabel(c host.StateCount) string {
	if c.N == 0 {
		return c.State
	}
	return fmt.Sprintf("%d %s", c.N, c.State)
}

func commandLines(cmds []string) string {
	var s string
	for _, c := range cmds {
		s += "$ " + c + "\n"
	}
	return s
}

func confirmVariant(danger bool) button.Variant {
	if danger {
		return button.VariantDestructive
	}
	return button.VariantDefault
}

templ JobPage(p Page, j host.JobView) {
	@Layout(p) {
		<div class="space-y-3">
			@backLink("/jobs", "Jobs")
			<div class="space-y-1">
				<h1 class="flex items-center gap-2 font-heading text-lg font-semibold">
					@jobIcon(j, "size-5 shrink-0")
					<span class="break-all">{ j.Title }</span>
				</h1>
				<p class="text-sm text-muted-foreground tabular-nums">
					started { j.Started } · { j.Duration }
					if !j.Done {
						· refreshing every 2s
					}
				</p>
				if j.Failed {
					<p class="text-sm text-destructive">{ j.Status }</p>
				}
			</div>
		</div>
		@output(j.Output)
		@button.Button(button.Props{Href: "/", Variant: button.VariantOutline}) {
			@icon.Stack(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
			Back to stacks
		}
	}
}

templ jobIcon(j host.JobView, size string) {
	switch  {
		case !j.Done:
			@icon.CircleNotch(icon.Props{Class: size + " animate-spin text-warn"})
		case j.Failed:
			@icon.XCircle(icon.Props{Class: size + " text-destructive"})
		default:
			@icon.CheckCircle(icon.Props{Class: size + " text-ok"})
	}
}

templ JobsPage(p Page, jobs []host.JobView) {
	@Layout(p) {
		@pageTitle(icon.ClockCounterClockwise, "Jobs")
		if len(jobs) == 0 {
			@muted("No jobs since the last restart.")
		} else {
			@card.Card() {
				@card.Content() {
					<ul class="divide-y">
						for _, j := range jobs {
							<li class="space-y-1 py-2.5">
								<a class="flex items-center gap-2 font-medium text-primary underline-offset-4 hover:underline" href={ templ.SafeURL("/jobs/" + j.ID) }>
									@jobIcon(j, "size-4 shrink-0")
									<span class="break-all">{ j.Title }</span>
								</a>
								<div class="pl-6 text-xs text-muted-foreground tabular-nums">
									{ j.Started } · { j.Duration }
								</div>
								if j.Failed {
									<div class="pl-6 text-xs text-destructive">{ j.Status }</div>
								}
							</li>
						}
					</ul>
				}
			}
		}
	}
}

templ ServicesPage(p Page, lists []UnitList) {
	@Layout(p) {
		@pageTitle(icon.GearSix, "Services")
		for _, l := range lists {
			@card.Card() {
				@card.Header() {
					@card.Title(card.TitleProps{Class: "flex items-center gap-2"}) {
						if l.User {
							@icon.Plug(icon.Props{Class: "size-4 text-muted-foreground"})
						} else {
							@icon.HardDrives(icon.Props{Class: "size-4 text-muted-foreground"})
						}
						{ l.Title }
						if l.Failed > 0 {
							@toneBadge("bad", fmt.Sprintf("%d failed", l.Failed))
						}
					}
					@card.Description() {
						{ strconv.Itoa(len(l.Units)) } loaded units, failed first. Read only.
					}
				}
				@card.Content() {
					if l.Err != "" {
						@errorAlert(l.Err)
					}
					if len(l.Units) > 0 {
						<ul class="divide-y border-t">
							for _, u := range l.Units {
								<li class="space-y-0.5 py-2">
									<div class="flex min-w-0 items-center gap-2">
										@statusDot(u.Active)
										<span class="truncate font-medium">{ u.Name }</span>
										<span class="shrink-0 text-xs text-muted-foreground">{ u.Sub }</span>
									</div>
									if u.Description != "" {
										<div class="truncate pl-4.5 text-xs text-muted-foreground">{ u.Description }</div>
									}
								</li>
							}
						</ul>
					}
				}
			}
		}
	}
}

templ CronPage(p Page, d Cron) {
	@Layout(p) {
		@pageTitle(icon.CalendarDots, "Cron")
		@card.Card() {
			@card.Header() {
				@card.Title() {
					User crontab
				}
				@card.Description() {
					Read only. Edit with <code class="font-mono">crontab -e</code> on the server.
				}
			}
			@card.Content() {
				if d.Err != "" {
					@errorAlert(d.Err)
				} else if d.Crontab == "" {
					@muted("No crontab for this user.")
				} else {
					@output(d.Crontab)
				}
			}
		}
	}
}

templ ErrorPage(p Page, msg string) {
	@Layout(p) {
		@errorAlert(msg)
		@backLink("/", "Stacks")
	}
}
