package views

import (
	"strconv"
	"yasssm/components/alert"
	"yasssm/components/badge"
	"yasssm/components/button"
	"yasssm/components/icon"
)

type navItem struct {
	href, label, key string
	icon             func(...icon.Props) templ.Component
}

var navItems = []navItem{
	{"/", "Stacks", "stacks", icon.Stack},
	{"/services", "Services", "services", icon.GearSix},
	{"/cron", "Cron", "cron", icon.CalendarDots},
	{"/jobs", "Jobs", "jobs", icon.ClockCounterClockwise},
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			if p.Refresh > 0 {
				<meta http-equiv="refresh" content={ strconv.Itoa(p.Refresh) }/>
			}
			<title>{ p.Title } · yasssm</title>
			<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="min-h-svh bg-background font-sans text-foreground antialiased">
			if p.Authed {
				<header class="sticky top-0 z-10 border-b bg-background/95 backdrop-blur">
					<div class="mx-auto flex h-14 max-w-6xl items-center gap-1 px-4 sm:h-12">
						<a href="/" class="mr-3 flex min-w-0 items-baseline gap-2" title="Yet Another Simple Self-hosted Server Manager">
							<span class="self-center text-lg leading-none" aria-hidden="true">🐍</span>
							<span class="font-semibold">yasssm</span>
							<span class="truncate text-sm text-muted-foreground">{ p.Host }</span>
						</a>
						<nav class="hidden items-center gap-1 sm:flex" aria-label="Main">
							for _, n := range navItems {
								@navLink(n, p.Nav == n.key)
							}
						</nav>
						<form method="post" action="/logout" class="ml-auto shrink-0">
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIconSm,
								Type:       button.TypeSubmit,
								Attributes: templ.Attributes{"title": "Log out", "aria-label": "Log out"},
							}) {
								@icon.SignOut()
							}
						</form>
					</div>
				</header>
				// Phones get a bottom tab bar in thumb reach instead of the header links.
				<nav class="fixed inset-x-0 bottom-0 z-10 grid grid-cols-4 border-t bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur sm:hidden" aria-label="Main">
					for _, n := range navItems {
						@tabLink(n, p.Nav == n.key)
					}
				</nav>
			}
			<main class={ "mx-auto max-w-6xl space-y-6 p-4", templ.KV("pb-24 sm:pb-4", p.Authed) }>
				{ children... }
			</main>
		</body>
	</html>
}

templ navLink(n navItem, active bool) {
	@button.Button(button.Props{
		Href:       n.href,
		Size:       button.SizeSm,
		Variant:    button.VariantGhost,
		Class:      navActive(active),
		Attributes: ariaCurrent(active),
	}) {
		@n.icon(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
		{ n.label }
	}
}

templ tabLink(n navItem, active bool) {
	<a
		href={ templ.SafeURL(n.href) }
		class={ "flex h-14 flex-col items-center justify-center gap-0.5 text-xs", navActive(active) }
		{ ariaCurrent(active)... }
	>
		@n.icon(icon.Props{Class: "size-5"})
		{ n.label }
	</a>
}

// navActive marks the current page with the yellow highlight.
func navActive(active bool) string {
	if active {
		return "bg-accent text-accent-foreground"
	}
	return "text-muted-foreground"
}

func ariaCurrent(active bool) templ.Attributes {
	if active {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// actionIcon maps an action name to its icon.
func actionIcon(action string) func(...icon.Props) templ.Component {
	switch action {
	case "logs":
		return icon.Scroll
	case "up", "start":
		return icon.Play
	case "restart":
		return icon.ArrowClockwise
	case "update":
		return icon.CloudArrowDown
	case "stop":
		return icon.Stop
	}
	return icon.WarningCircle
}

func actionVariant(danger bool) button.Variant {
	if danger {
		return button.VariantDestructive
	}
	return button.VariantOutline
}

// actionButton is an icon + label button, for stack-level actions.
templ actionButton(l Link) {
	@button.Button(button.Props{Href: l.URL, Size: button.SizeSm, Variant: actionVariant(l.Danger)}) {
		@actionIcon(l.Action)(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
		{ l.Label }
	}
}

// iconAction is an icon-only ghost button with a native tooltip, for list
// rows; destructive ones only tint the icon.
templ iconAction(l Link) {
	@button.Button(button.Props{
		Href:       l.URL,
		Size:       button.SizeIconSm,
		Variant:    button.VariantGhost,
		Class:      dangerText(l.Danger),
		Attributes: templ.Attributes{"title": l.Label, "aria-label": l.Label},
	}) {
		@actionIcon(l.Action)()
	}
}

func dangerText(danger bool) string {
	if danger {
		return "text-destructive hover:bg-destructive/10 hover:text-destructive dark:hover:bg-destructive/20"
	}
	return ""
}

// toneBadge colors a state badge by tone (see stateTone): green ok, red bad,
// amber transitional, neutral otherwise.
templ toneBadge(tone, text string) {
	switch tone {
		case "ok":
			@badge.Badge(badge.Props{Class: "bg-ok/10 text-ok"}) {
				{ text }
			}
		case "bad":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				{ text }
			}
		case "warn":
			@badge.Badge(badge.Props{Class: "bg-warn/10 text-warn"}) {
				{ text }
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ text }
			}
	}
}

// statusDot is a traffic light for a Docker or systemd state; the state name
// is the tooltip and the accessible label. Transitional states pulse.
templ statusDot(state string) {
	<span class={ "relative inline-flex size-2.5 shrink-0 rounded-full ring-3", dotColor(stateTone(state)) } title={ state } role="img" aria-label={ state }>
		if stateTone(state) == "warn" {
			<span class="absolute inline-flex size-full animate-ping rounded-full bg-warn opacity-75"></span>
		}
	</span>
}

// statusLine is a dot followed by detail text, e.g. "Up 2 days (healthy)".
templ statusLine(state, text string) {
	<span class="inline-flex items-center gap-2">
		@statusDot(state)
		<span>{ text }</span>
	</span>
}

func dotColor(tone string) string {
	switch tone {
	case "ok":
		return "bg-ok ring-ok/20"
	case "bad":
		return "bg-destructive ring-destructive/20"
	case "warn":
		return "bg-warn ring-warn/20"
	}
	return "bg-muted-foreground/60 ring-muted-foreground/15"
}

func stateTone(state string) string {
	switch state {
	case "running", "active", "done":
		return "ok"
	case "exited", "dead", "failed", "unhealthy":
		return "bad"
	case "restarting", "paused", "created", "activating", "reloading", "starting", "running…":
		return "warn"
	}
	return ""
}

templ errorAlert(msg string) {
	@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
		@icon.Warning()
		@alert.Title() {
			Error
		}
		@alert.Description() {
			{ msg }
		}
	}
}

templ output(text string) {
	<pre class="max-h-[75vh] overflow-auto rounded-lg border bg-muted/40 p-3 font-mono text-xs break-all whitespace-pre-wrap">{ text }</pre>
}

templ muted(text string) {
	<p class="text-sm text-muted-foreground">{ text }</p>
}

// pageTitle is the h1 with a leading icon used on every page.
templ pageTitle(ic func(...icon.Props) templ.Component, title string) {
	<h1 class="flex min-w-0 items-center gap-2 font-heading text-lg font-semibold">
		@ic(icon.Props{Class: "size-5 shrink-0 text-muted-foreground"})
		<span class="truncate">{ title }</span>
	</h1>
}

templ backLink(href, label string) {
	@button.Button(button.Props{Href: href, Variant: button.VariantGhost, Size: button.SizeSm, Class: "-ml-2"}) {
		@icon.ArrowLeft(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
		{ label }
	}
}
