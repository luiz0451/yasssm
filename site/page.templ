// Package site is the project website (GitHub Pages). It is built from the app's own templ
// components, theme and icons, so it looks like the app; `make site` renders it to site/dist.
package site

import (
	"yasssm/components/button"
	"yasssm/components/card"
	"yasssm/components/icon"
)

const repo = "https://github.com/luiz0451/yasssm"

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			<title>yasssm · a small web panel for one Linux server</title>
			<meta name="description" content="yasssm is a small web panel for one Linux server: Docker Compose stacks, services, cron and system stats. One Go binary, no JavaScript, TOTP login."/>
			<link rel="icon" type="image/svg+xml" href="assets/favicon.svg"/>
			<link rel="canonical" href="https://yasssm.luizlab.com.br/"/>
			<link rel="apple-touch-icon" href="assets/icons/apple-touch-icon.png"/>
			<link rel="stylesheet" href="assets/css/site.css"/>
		</head>
		<body class="flex min-h-svh flex-col bg-background font-sans text-foreground antialiased">
			<main class="mx-auto w-full max-w-4xl flex-1 space-y-16 px-4 py-16 sm:py-24">
				<section class="grid items-center gap-12 md:grid-cols-[1.1fr_1fr]">
					<div class="space-y-5">
						<div class="flex items-center gap-2 text-2xl font-semibold"><span aria-hidden="true">🐍</span> yasssm</div>
						<h1 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">A small web panel for one Linux server.</h1>
						<p class="max-w-prose text-muted-foreground">
							Manage Docker Compose stacks and check services, cron and system load from your phone. One Go binary, no JavaScript.
						</p>
						<div class="flex flex-wrap gap-2">
							@button.Button(button.Props{Href: repo}) {
								GitHub
							}
							@button.Button(button.Props{Href: "#install", Variant: button.VariantOutline}) {
								Install
							}
						</div>
					</div>
					@preview()
				</section>
				<section id="install" class="space-y-4">
					<h2 class="font-heading text-xl font-semibold">Install</h2>
					@code("make build-linux\ninstall -m 755 bin/yasssm-linux-amd64 ~/.local/bin/yasssm\nyasssm totp-init")
					<p class="text-sm text-muted-foreground">
						Running it as a service and reaching it over Tailscale: see the <a class="text-foreground underline underline-offset-4" href={ templ.SafeURL(repo + "#readme") }>README</a>.
					</p>
				</section>
			</main>
			<footer class="mx-auto w-full max-w-4xl px-4 py-6 text-sm text-muted-foreground">
				GPL-3.0 · <a class="underline underline-offset-4" href={ templ.SafeURL(repo) }>GitHub</a>
			</footer>
		</body>
	</html>
}

// preview is a static mock of the app's main screen, made of the app's own components.
templ preview() {
	<div class="mx-auto w-full max-w-sm rounded-[2rem] border bg-muted/30 p-3 shadow-sm" aria-hidden="true">
		<div class="space-y-3 rounded-[1.5rem] bg-background p-3">
			<div class="flex items-center gap-2 px-1 pt-1 text-sm">
				<span>🐍</span>
				<span class="font-semibold">yasssm</span>
				<span class="text-muted-foreground">homelab</span>
			</div>
			<div class="grid grid-cols-3 gap-2">
				@stat("Load", "0.42")
				@stat("Memory", "38%")
				@stat("Disk", "61%")
			</div>
			@card.Card() {
				@card.Header() {
					@card.Title(card.TitleProps{Class: "flex items-center gap-2"}) {
						@icon.Stack(icon.Props{Class: "size-4 text-muted-foreground"})
						media
						<span class="inline-flex items-center gap-1.5 text-xs font-normal text-muted-foreground">
							@dot("bg-ok ring-ok/20")
							3
						</span>
					}
					@card.Description() {
						<span class="font-mono text-xs">~/media/compose.yaml</span>
					}
				}
				@card.Content() {
					<ul class="divide-y border-t">
						@row("bg-ok ring-ok/20", "jellyfin", "Up 4 days")
						@row("bg-ok ring-ok/20", "sonarr", "Up 4 days")
						@row("bg-warn ring-warn/20", "radarr", "Restarting")
					</ul>
				}
				@card.Footer(card.FooterProps{Class: "gap-1.5"}) {
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline}) {
						@icon.ArrowClockwise(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
						Restart
					}
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline}) {
						@icon.CloudArrowDown(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
						Pull
					}
				}
			}
		</div>
	</div>
}

templ stat(name, value string) {
	<div class="rounded-lg border bg-card px-2.5 py-2">
		<div class="text-xs text-muted-foreground">{ name }</div>
		<div class="font-mono text-sm">{ value }</div>
	</div>
}

templ dot(color string) {
	<span class={ "inline-flex size-2.5 shrink-0 rounded-full ring-3", color }></span>
}

templ row(color, name, status string) {
	<li class="flex items-center gap-2 py-2 text-sm">
		@dot(color)
		<span class="font-medium">{ name }</span>
		<span class="ml-auto text-xs text-muted-foreground">{ status }</span>
	</li>
}

templ code(text string) {
	<pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 font-mono text-sm">{ text }</pre>
}
