// Package site is the project website (GitHub Pages): a home page and a docs page, built
// with the app's own components, icons and colours. `make site` renders it to site/dist.
package site

import (
	"yasssm/components/button"
	"yasssm/components/icon"
)

const repo = "https://github.com/luiz0451/yasssm"

const linuxInstall = `# build and install the binary
make build-linux
install -m 755 bin/yasssm-linux-amd64 ~/.local/bin/yasssm

# scan the QR code with your authenticator app
yasssm totp-init

# run it as a user service that survives logout and reboots
cp deploy/yasssm.service ~/.config/systemd/user/
systemctl --user daemon-reload
systemctl --user enable --now yasssm
loginctl enable-linger`

const macInstall = `# build and install the binary
make build-darwin
install -m 755 bin/yasssm-darwin-arm64 ~/.local/bin/yasssm

# scan the QR code with your authenticator app
yasssm totp-init

# run it as a launchd agent that starts when you log in
sed "s|HOME|$HOME|g" deploy/com.yasssm.plist > ~/Library/LaunchAgents/com.yasssm.plist
launchctl load ~/Library/LaunchAgents/com.yasssm.plist`

// The one-line installers (site/install.sh, site/install-macos.sh), shown on the home page.
const (
	linuxOneLiner = "curl -fsSL https://yasssm.luizlab.com.br/install.sh | sh"
	macOneLiner   = "curl -fsSL https://yasssm.luizlab.com.br/install-macos.sh | sh"
)

// shell is the page frame: content and a plain footer. Navigation lives in each page (buttons on
// the home page, the sidebar on the docs).
templ shell(title, path string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title }</title>
			<meta name="description" content="Yet Another Simple Self-hosted Server Manager: manage your server from any device on your private network."/>
			<link rel="icon" type="image/svg+xml" href="assets/favicon.svg"/>
			<link rel="canonical" href={ "https://yasssm.luizlab.com.br/" + path }/>
			<link rel="apple-touch-icon" href="assets/icons/apple-touch-icon.png"/>
			<link rel="stylesheet" href="assets/css/site.css"/>
			<link rel="stylesheet" href="assets/css/highlight.css"/>
		</head>
		<body class="flex min-h-svh flex-col bg-background font-sans text-foreground antialiased">
			<main class="mx-auto w-full max-w-5xl flex-1 space-y-10 px-4 pt-12 pb-12 sm:pt-16">
				{ children... }
			</main>
			<footer class="border-t">
				<div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-3 gap-y-2 px-4 py-6 text-sm text-muted-foreground">
					<span>GPL-3.0</span>
					<a class="ml-auto inline-flex items-center gap-1.5 hover:text-foreground" href="https://ko-fi.com/luizcarvalho">
						@icon.Coffee(icon.Props{Class: "size-5"})
						Tip me on Ko-fi
					</a>
				</div>
			</footer>
			@copyScript()
		</body>
	</html>
}

templ Page() {
	@shell("yasssm · Yet Another Simple Self-hosted Server Manager", "") {
		<section class="mx-auto flex max-w-4xl flex-col items-center gap-8 py-6 text-center sm:py-12">
			<div class="space-y-3">
				<div class="text-6xl leading-none" aria-hidden="true">🐍</div>
				<h1 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
					<span class="block">Yet Another</span>
					<span class="block">Simple Self-hosted</span>
					<span class="block">Server Manager</span>
				</h1>
				<p class="text-lg text-muted-foreground">Manage your server from any device on your private network.</p>
			</div>
			<div class="flex gap-2">
				@button.Button(button.Props{Href: "docs.html"}) {
					Docs
				}
				@sourceButton()
			</div>
			@oneLiner()
		</section>
	}
}

templ sourceButton() {
	@button.Button(button.Props{Href: repo, Variant: button.VariantOutline}) {
		@icon.GithubLogo(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
		Source
	}
}

// oneLiner is the install command in one box: Linux/macOS tabs (radio buttons, no script) and a
// copy button in its header.
templ oneLiner() {
	<div id="install" data-code class="group/install w-full max-w-2xl overflow-hidden rounded-lg border bg-muted/40 text-left">
		<div class="flex items-center gap-4 border-b bg-background/60 pr-1.5 pl-3 text-sm">
			@tab("linux", "Linux", true)
			@tab("macos", "macOS", false)
			@copyButton("ml-auto")
		</div>
		<pre class="chroma hidden overflow-auto p-3 font-mono text-sm group-has-[#os-linux:checked]/install:block">
			@highlight(linuxOneLiner, "bash")
		</pre>
		<pre class="chroma hidden overflow-auto p-3 font-mono text-sm group-has-[#os-macos:checked]/install:block">
			@highlight(macOneLiner, "bash")
		</pre>
	</div>
}

// tab is an underlined tab; the checked radio inside it marks the active one.
templ tab(id, label string, checked bool) {
	<label class="-mb-px cursor-pointer border-b-2 border-transparent py-2 text-muted-foreground hover:text-foreground has-checked:border-foreground has-checked:font-medium has-checked:text-foreground has-focus-visible:underline">
		<input type="radio" name="os" id={ "os-" + id } class="sr-only" checked?={ checked }/>
		{ label }
	</label>
}

// code is a highlighted shell block with a copy button in its corner.
templ code(text string) {
	<div data-code class="relative">
		<pre class="chroma overflow-auto rounded-lg border bg-muted/40 p-3 pr-12 text-left font-mono text-xs leading-relaxed">
			@highlight(text, "bash")
		</pre>
		@copyButton("absolute top-2 right-2")
	</div>
}

// copyButton copies the visible <pre> of the enclosing [data-code] block.
templ copyButton(class string) {
	<button type="button" data-copy class={ "group/copy inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground", class } title="Copy" aria-label="Copy">
		@icon.CopyRegular(icon.Props{Class: "size-4 group-data-copied/copy:hidden"})
		@icon.CheckRegular(icon.Props{Class: "hidden size-4 text-ok group-data-copied/copy:block"})
	</button>
}

// copyScript is the site's only script: copy a code block to the clipboard.
templ copyScript() {
	<script>
		document.addEventListener("click", async (e) => {
			const b = e.target.closest("[data-copy]");
			if (!b) return;
			const pre = [...b.closest("[data-code]").querySelectorAll("pre")].find(
				(p) => p.offsetParent,
			);
			await navigator.clipboard.writeText(pre.innerText.trim());
			b.dataset.copied = "";
			setTimeout(() => delete b.dataset.copied, 1500);
		});
	</script>
}
